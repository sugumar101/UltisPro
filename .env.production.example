# Copy to .env.production (or set these as secrets in whatever hosts the
# API — Neon's own DB is only one piece; the app process itself still needs
# to run somewhere, e.g. ECS/Fly.io/Render/a VPS). Never commit the filled-in
# version of this file.
NODE_ENV=production

# API
API_PORT=4000
# Public URL of the deployed frontend — must match exactly (protocol + host,
# no trailing slash) or CORS in apps/api/src/app.ts (cors({ origin: env.WEB_ORIGIN }))
# will reject requests from it.
WEB_ORIGIN=https://app.yourdomain.com

# --- Neon Postgres ---
# Use the DIRECT (non-pooled) connection string here, not the one with
# "-pooler" in the hostname. This app is a long-running Express process with
# its own client-side pg.Pool (see apps/api/scripts/migrate.ts and wherever
# the runtime pool is constructed) — routing that through Neon's PgBouncer
# pooler as well would double-pool for no benefit, and PgBouncer's
# transaction-pooling mode disallows some session-level SQL if you ever add
# any (e.g. SET search_path).
#
# Get this from the Neon console: Project -> Connect -> toggle "Connection
# pooling" OFF -> copy the connection string shown.
# Format: postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<dbname>?sslmode=require&channel_binding=require
#
# If you ever see a connection error mentioning "channel binding" (some
# older Postgres client libraries don't support it), drop that parameter:
# ...neon.tech/<dbname>?sslmode=require
DATABASE_URL=postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<dbname>?sslmode=require&channel_binding=require

# --- Redis ---
# Not provisioned by this change — bring your own (Upstash, ElastiCache, a
# managed Redis add-on, etc.). Currently unused by application code beyond
# being validated at boot (config/env.ts); wire it up before relying on it.
REDIS_URL=rediss://<user>:<password>@<host>:<port>

# Generate with: openssl rand -base64 48
# Must be at least 32 characters (enforced in apps/api/src/config/env.ts).
# Rotating this invalidates every issued access token — plan for that.
JWT_SECRET=REPLACE_WITH_A_REAL_RANDOM_SECRET_AT_LEAST_32_CHARS
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Web
NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# --- Security (see docs/07-production-security.md) ---
# Number of reverse proxies you control in front of the API. Getting this
# wrong breaks per-IP rate limiting and audit-log accuracy: too low and every
# client shares one bucket, too high and a client can forge X-Forwarded-For
# to spoof any source IP. One ALB/ingress = 1. Cloudflare + ALB = 2.
TRUST_PROXY_HOPS=1

# Extra browser origins allowed to call the API, comma-separated. Leave blank
# unless a second frontend (e.g. staging) shares this API.
EXTRA_CORS_ORIGINS=

# 'lax' is correct when the frontend and API share a registrable domain
# (app.example.com + api.example.com). Use 'none' ONLY if they are genuinely
# different sites — it requires Secure and removes SameSite's CSRF
# protection, leaving the CORS allow-list as the only control.
COOKIE_SAMESITE=lax

# Leave true unless TLS terminates inside the container itself.
ENFORCE_HTTPS=true

# --- Capacity (see docs/08-scaling.md) ---
# Connections PER INSTANCE. Budget against the database's own limit:
# DB_POOL_MAX x replica count must stay well under the server's
# max_connections, because exceeding it hard-fails rather than queueing.
DB_POOL_MAX=20

# Any statement exceeding this is cancelled, freeing its pool slot. Without
# it, one pathological query can drain the pool and stall the whole API.
DB_STATEMENT_TIMEOUT_MS=15000
